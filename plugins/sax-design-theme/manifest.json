{
  "schemaVersion": 1,
  "id": "${PLUGIN_NAMESPACE}.sax-design-theme",
  "name": "sax-design-theme",
  "version": "0.5.3",
  "description": "Sax 色彩玻璃主题：原生 8px 圆角、弹层与任务退出的 SVG 粒子溶解试用版。",
  "main": "main.js",
  "renderer": "renderer/extension.mjs",
  "ui": {
    "panel": "renderer/index.html",
    "title": "sax-design-theme"
  },
  "contributes": {
    "windowAppearance": {
      "backgroundColor": { "light": "#00000000", "dark": "#00000000" },
      "cornerRadius": 8
    },
    "themes": [
      { "id": "sax-light", "label": "Sax Light · 留白", "base": "light", "path": "themes/sax-light.css" },
      { "id": "sax-dark", "label": "Sax Dark · 浮影", "base": "dark", "path": "themes/sax-dark.css" }
    ],
    "commands": [
      {
        "id": "pi-desktop-sax-theme.open",
        "title": "sax-design-theme: Open Panel",
        "keywords": [
          "sax-design-theme",
          "pi-desktop-sax-theme"
        ]
      }
    ]
  },
  "permissions": [
    "ui.panel",
    "ui.theme",
    "ui.window.appearance",
    "renderer.extension"
  ],
  "engines": {
    "piDesktop": ">=0.17.0"
  },
  "activationEvents": [
    "onCommand:pi-desktop-sax-theme.open",
    "onStartup"
  ]
}
