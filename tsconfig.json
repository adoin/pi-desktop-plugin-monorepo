{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@pi-plugins/plugin-types": ["packages/plugin-types/src/index.ts"],
      "@pi-plugins/test-utils": ["packages/test-utils/browser.ts"]
    }
  },
  "include": ["scripts/**/*.ts", "packages/**/*.ts", "plugins/**/*.ts"],
  "exclude": ["node_modules", ".artifacts"]
}
